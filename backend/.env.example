# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+asyncpg://ai_tutor:ai_tutor@localhost:5432/lumora
JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
OPENCODE_ZEN_API_KEY=
# Internet search (ADR 0012) -- Tavily is required for TaskType.INTERNET_SEARCH; Brave is
# an optional fallback, only attempted when this key is configured.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Optional (ADR 0010) -- Openverse image search works anonymously/keyless out of the box;
# set both to raise the anonymous rate limit via an OAuth2 client-credentials app
# (register at https://api.openverse.org/v1/auth_tokens/register/).
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
CORS_ORIGINS=["http://localhost:5173"]
REDIS_URL=redis://localhost:6380/0
LOCAL_STORAGE_ROOT=./storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
